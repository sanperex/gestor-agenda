# Copia este archivo como .env y llena los valores. .env NUNCA se sube a GitHub.

# Conexion a MongoDB Atlas. El nombre despues de ".net/" es la base de datos.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/gestor_agenda?retryWrites=true&w=majority

# Clave para firmar los JWT. Larga y aleatoria. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Duracion del token
JWT_EXPIRES_IN=7d

# Puerto local (Railway pone el suyo automaticamente)
PORT=3000

# Origenes permitidos para CORS: "*" o lista separada por comas
CORS_ORIGIN=*

# true = forgot-password devuelve el codigo en la respuesta (solo demo academica)
RESET_CODE_DEMO=true
